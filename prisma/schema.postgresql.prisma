generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum ProjectStatus {
  IN_PROGRESS
  DONE
  SUPPORT
}

enum ServiceMediaType {
  IMAGE
  VIDEO
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum MailNotificationStatus {
  UNTRACKED
  PENDING
  SMTP_ACCEPTED
  FAILED
  UNKNOWN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CLIENT)
  createdAt    DateTime  @default(now())
  projects     Project[]
  sessions     Session[]
  tzIdentity   TzIdentityLink?
  planEdits    BillingPlanAudit[]
  invoices     Invoice[]
  orders       BusinessOrder[]
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String
  previewPath String
  projectUrl  String
  status      ProjectStatus @default(IN_PROGRESS)
  isPublic    Boolean       @default(false)
  clientId    String?
  client      User?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([isPublic])
}

model Service {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  shortDescription String
  fullDescription String
  includes        String
  stages          String
  sortOrder       Int           @default(0)
  isPublished     Boolean       @default(false)
  media           ServiceMedia[]
  leads           LeadRequest[]
  aliases         ServiceAlias[]
  billingPlans    BillingPlan[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([sortOrder])
  @@index([isPublished])
}

model ServiceMedia {
  id        String          @id @default(cuid())
  serviceId String
  type      ServiceMediaType
  path      String
  sortOrder Int             @default(0)
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@index([serviceId])
  @@index([serviceId, sortOrder])
}

model SiteSettings {
  id           String   @id
  tagline      String
  heroTitle    String
  heroSubtitle String
  contacts     String
  updatedAt    DateTime @updatedAt
}

model LeadRequest {
  legalSnapshot String @default("")
  id            String     @id @default(cuid())
  name          String
  email         String
  phone         String
  company       String
  serviceId     String?
  serviceTitle  String
  message       String
  status        LeadStatus @default(NEW)
  clientEmailStatus MailNotificationStatus @default(UNTRACKED)
  internalEmailStatus MailNotificationStatus @default(UNTRACKED)
  clientEmailAttempts Int @default(0)
  internalEmailAttempts Int @default(0)
  clientEmailAttemptedAt DateTime?
  internalEmailAttemptedAt DateTime?
  clientEmailErrorCategory String?
  internalEmailErrorCategory String?
  privacyConsentAt DateTime
  agreementAcceptedAt DateTime?
  agreementVersion String?
  privacyVersion String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  jobs          MailJob[]
  submissionKey String? @unique
  requestHash String?
  service       Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([serviceId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tzIssuer String?
  tzSubject String?
  tzAccessTokenEncrypted String?

  @@index([userId])
  @@index([expiresAt])
}

model IntegrationCheck {
  key String @id
  status String
  checkedAt DateTime @default(now())
  errorCategory String?
}

model TzIdentityLink {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer String
  subject String
  createdAt DateTime @default(now())
  @@unique([issuer, subject])
}
model TzLoginAttempt {
  stateHash String @id
  localUserId String?
  expiresAt DateTime
  consumedAt DateTime?
  @@index([expiresAt])
}
model BillingPlan {
  productType String @default("SERVICE")
  projectKey String @default("business")
  projectUrl String @default("https://business.trioz.ru")
  cardImageUrl String @default("")
  features String @default("")
  fulfillmentTerms String @default("")

  id String @id @default(cuid())
  kind String
  serviceId String?
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  title String
  description String
  mode String
  settlementMode String @default("PREPAYMENT")
  externalProductId String @default("")
  amountMinor Int?
  currency String @default("RUB")
  periodUnit String?
  periodCount Int?
  renewalTerms String @default("")
  cancellationTerms String @default("")
  internalNotes String @default("")
  isPublished Boolean @default(false)
  isArchived Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  edits BillingPlanAudit[]
  orders BusinessOrder[]
  @@index([isPublished, isArchived])
  @@index([serviceId])
}
model BillingPlanAudit {
  id String @id @default(cuid())
  planId String
  plan BillingPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  revision Int
  snapshot String
  createdAt DateTime @default(now())
  @@unique([planId, revision])
}

model ServiceAlias {
  slug String @id
  serviceId String
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@index([serviceId])
}
model CommerceSettings {
  id String @id @default("commerce")
  sellerName String @default("")
  sellerDetails String @default("")
  sellerInn String @default("")
  sellerKpp String @default("")
  bankName String @default("")
  bankBik String @default("")
  bankAccount String @default("")
  bankCorrespondentAccount String @default("")
  supportEmail String @default("info@trioz.ru")
  paymentInstructions String @default("")
  fulfillmentTerms String @default("")
  refundTerms String @default("")
  approved Boolean @default(false)
  revision Int @default(1)
  updatedAt DateTime @updatedAt
}
model BusinessOrder {
  payments BankPayment[]
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId String
  plan BillingPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  requestKey String
  requestHash String
  title String
  settlementMode String
  amountMinor Int?
  currency String
  planRevision Int
  snapshot String
  status String @default("REQUESTED")
  history String @default("[]")
  message String
  acceptedAt DateTime
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([status])
}
model RateBucket {
  key String @id
  hits Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
model MailJob {
  id String @id @default(cuid())
  leadId String
  lead LeadRequest @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel String
  attempts Int @default(0)
  status String @default("PENDING")
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  errorCategory String?
  @@unique([leadId, channel])
  @@index([status, availableAt])
}

model Invoice {
  id String @id @default(cuid())
  number String @unique
  requestKey String @unique
  requestHash String
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  orderId String?
  method String
  status String @default("ISSUED")
  revision Int @default(1)
  title String
  amountMinor Int
  currency String @default("RUB")
  buyerName String
  buyerInn String @default("")
  buyerDetails String @default("")
  sellerSnapshot String
  taxNote String
  paymentUrl String @default("")
  periodMonths Int?
  renewalTerms String @default("")
  dueDate DateTime
  paidAt DateTime?
  paymentReference String @default("")
  createdById String
  history String @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,createdAt])
  @@index([status,createdAt])
}

model MaintenanceState {
 key String @id
 lastSuccessAt DateTime
}

model LegalPage {
  slug String @id
  title String
  body String
  revision Int @default(1)
  publishedVersion String?
  updatedAt DateTime @updatedAt
}
model LegalPublication {
  id String @id @default(cuid())
  slug String
  version String @unique
  title String
  body String
  digest String
  actorId String
  publishedAt DateTime @default(now())
  @@index([slug, publishedAt])
}
model PageViewDaily {
  day String
  path String
  views Int @default(0)
  @@id([day, path])
}

model BankPayment {
  id String @id @default(cuid())
  orderId String
  order BusinessOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  activeKey String? @unique
  paymentId String? @unique
  terminalKey String
  amountMinor Int
  status String @default("CREATING")
  paymentUrl String @default("")
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId, createdAt])
}
