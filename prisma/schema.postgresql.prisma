generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum ProjectStatus {
  IN_PROGRESS
  DONE
  SUPPORT
}

enum ServiceMediaType {
  IMAGE
  VIDEO
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum MailNotificationStatus {
  UNTRACKED
  PENDING
  SMTP_ACCEPTED
  FAILED
  UNKNOWN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CLIENT)
  createdAt    DateTime  @default(now())
  projects     Project[]
  sessions     Session[]
  tzIdentity   TzIdentityLink?
  planEdits    BillingPlanAudit[]
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String
  previewPath String
  projectUrl  String
  status      ProjectStatus @default(IN_PROGRESS)
  isPublic    Boolean       @default(false)
  clientId    String?
  client      User?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([isPublic])
}

model Service {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  shortDescription String
  fullDescription String
  includes        String
  stages          String
  sortOrder       Int           @default(0)
  isPublished     Boolean       @default(false)
  media           ServiceMedia[]
  leads           LeadRequest[]
  billingPlans    BillingPlan[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([sortOrder])
  @@index([isPublished])
}

model ServiceMedia {
  id        String          @id @default(cuid())
  serviceId String
  type      ServiceMediaType
  path      String
  sortOrder Int             @default(0)
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@index([serviceId])
  @@index([serviceId, sortOrder])
}

model SiteSettings {
  id           String   @id
  tagline      String
  heroTitle    String
  heroSubtitle String
  contacts     String
  updatedAt    DateTime @updatedAt
}

model LeadRequest {
  id            String     @id @default(cuid())
  name          String
  email         String
  phone         String
  company       String
  serviceId     String?
  serviceTitle  String
  message       String
  status        LeadStatus @default(NEW)
  clientEmailStatus MailNotificationStatus @default(UNTRACKED)
  internalEmailStatus MailNotificationStatus @default(UNTRACKED)
  clientEmailAttempts Int @default(0)
  internalEmailAttempts Int @default(0)
  clientEmailAttemptedAt DateTime?
  internalEmailAttemptedAt DateTime?
  clientEmailErrorCategory String?
  internalEmailErrorCategory String?
  privacyConsentAt DateTime
  agreementAcceptedAt DateTime?
  agreementVersion String?
  privacyVersion String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  service       Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([serviceId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tzIssuer String?
  tzSubject String?
  tzAccessTokenEncrypted String?

  @@index([userId])
  @@index([expiresAt])
}

model IntegrationCheck {
  key String @id
  status String
  checkedAt DateTime @default(now())
  errorCategory String?
}

model TzIdentityLink {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer String
  subject String
  createdAt DateTime @default(now())
  @@unique([issuer, subject])
}
model TzLoginAttempt {
  stateHash String @id
  localUserId String?
  expiresAt DateTime
  consumedAt DateTime?
  @@index([expiresAt])
}
model BillingPlan {
  id String @id @default(cuid())
  kind String
  serviceId String?
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  title String
  description String
  mode String
  amountMinor Int?
  currency String @default("RUB")
  periodUnit String?
  periodCount Int?
  renewalTerms String @default("")
  cancellationTerms String @default("")
  internalNotes String @default("")
  isPublished Boolean @default(false)
  isArchived Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  edits BillingPlanAudit[]
  @@index([isPublished, isArchived])
  @@index([serviceId])
}
model BillingPlanAudit {
  id String @id @default(cuid())
  planId String
  plan BillingPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  revision Int
  snapshot String
  createdAt DateTime @default(now())
  @@unique([planId, revision])
}
