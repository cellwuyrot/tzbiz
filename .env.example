SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@trioz.ru"
SMTP_PASS="replace-with-mailbox-password"
EMAIL_FROM="info@trioz.ru"
LEADS_EMAIL_TO="info@trioz.ru"
