DATABASE_URL="file:../data/dev.db"
SESSION_SECRET="replace-with-a-random-32-byte-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password-of-at-least-10-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Почта для уведомлений о заявках. Основной путь — почтовый HTTP-сервис TrioZ,
# как в основном проекте: задайте SMTP_SERVICE_URL и ключ сайта из его админки.
SMTP_SERVICE_URL=""
SMTP_SERVICE_KEY=""
SMTP_FROM=""

# Резервный путь: прямой SMTP, если SMTP_SERVICE_URL/SMTP_SERVICE_KEY не заданы.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@trioz.ru"
SMTP_PASSWORD=""
# SMTP_PASS оставлен как совместимое старое имя при необходимости.
SMTP_PASS=""

# Для заявок по умолчанию: письмо приходит на info@trioz.ru.
EMAIL_FROM="info@trioz.ru"
LEADS_EMAIL_TO="info@trioz.ru"
