DATABASE_URL="file:../data/dev.db"
SESSION_SECRET="replace-with-a-random-32-byte-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production NEXT_PUBLIC_APP_URL="https://business.trioz.ru"
# SMTP: примеры; реальные host/user/pass предоставляет владелец.
# Логин не обязан совпадать с EMAIL_FROM; sender должен быть разрешён провайдером.
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="smtp-account@example.com"
SMTP_PASS="replace-with-mailbox-password"
EMAIL_FROM="union@business.trioz.ru"
LEADS_EMAIL_TO="info@trioz.ru"
EMAIL_REPLY_TO="info@trioz.ru"

# Админка → Интеграции показывает только наличие host/login/password.
# Реальные значения меняются на сервере; примеры SMTP выше нерабочие.
# SMTP verify не подтверждает право EMAIL_FROM и доставку в ящик.
# Выдача прав во внешние проекты не подключена; TZ ID отвечает за вход.

# TZ ID: confidential client зарегистрировать в существующей /admin/tz-id.
# Callback должен точно совпасть: https://business.trioz.ru/api/auth/tz-id/callback
# Scopes: openid profile email roles:read (проверка роли Business), без offline_access; сессия <=5 минут.
TZ_ID_ISSUER="https://id.trioz.ru"
TZ_ID_CLIENT_ID=""
TZ_ID_CLIENT_SECRET=""
# Отдельный ключ AES-256-GCM: 32 случайных байта в стандартном base64.
# Не публикуйте его и не перегенерируйте при обычном обновлении.
TZ_ID_TOKEN_KEY=""
# Парольный вход отключён. Seed создаёт только контент. Права админа назначаются в TZ ID.

# Enable only if a trusted reverse proxy overwrites forwarding headers and
# the app port cannot be reached directly. Otherwise limits share one bucket.
TRUST_PROXY_HEADERS="false"
# Run npm run jobs:run every minute (cron/systemd). No public cron endpoint.
# Cross-project entitlements require the receiving project API contract.
# См. RELEASE-1.3.0.md: интернет-эквайринг реализован через Т-Банк.

# Счета: точные домены HTTPS-ссылок из кабинета вашего платёжного провайдера.
# Пустое значение отключает выставление счетов со внешними ссылками.
# Не используйте wildcard, URL со схемой или случайные домены.
PAYMENT_LINK_HOSTS=""
# true только после фактического утверждения продавца, оферты и политики.
LEGAL_APPROVED="false"
# Автосписаний и автоматической выдачи подписок нет; оплачивается один период.

# Аналитика первой стороны не требует внешних ключей. По умолчанию выключена.
# Перед включением посетителем опубликуйте privacy и cookies в админке.
# jobs:run удаляет агрегаты старше 180 дней.
# До приёма заявок опубликуйте все 5 документов; одних файлов docs/*.md недостаточно.

# Т-Банк: только серверные переменные. Не добавляйте NEXT_PUBLIC_ к секретам.
# Включайте после проверки тестового терминала и документов.
TBANK_ENABLED="false"
TBANK_TERMINAL_KEY=""
TBANK_PASSWORD=""
# bank — банк фискализирует чек; external — чеки оформляет ваша отдельная касса.
# external НЕ освобождает от обязанностей по 54-ФЗ. Выбор должен подтвердить продавец.
TBANK_RECEIPT_MODE="bank"
# Укажите реальные налоговые настройки, согласованные с кассой/бухгалтером.
TBANK_TAXATION=""
TBANK_TAX=""
# Постоянный каталог медиа, сохраняемый при обновлении/между репликами.
# Например /var/lib/tzbiz/uploads. Пусто = ./uploads.
UPLOADS_DIR=""

# 1.3.1: PNG/JPEG/WebP processing uses system ImageMagick, not native sharp.
# Ubuntu: apt-get install imagemagick
# Leave these defaults unless binaries are installed in a custom location.
IMAGEMAGICK_CONVERT="convert"
IMAGEMAGICK_IDENTIFY="identify"

# Включать после разрешения «Продлевать вход» для существующего клиента Business в TrioZ.
TZ_ID_OFFLINE_ACCESS="0"

# Shared TZ ID service catalog. Uses existing TZ_ID_CLIENT_ID/SECRET, never new browser secrets.
SERVICE_HUB_ENABLED=0
SERVICE_HUB_ORIGIN=https://trioz.ru
# Safe defaults: no purchases or recurring charges until the owner completes the launch checklist.
SUBSCRIPTIONS_ENABLED=0
SUBSCRIPTION_TERMS_APPROVED=0
SUBSCRIPTION_CONSENT_VERSION=services-v1
TBANK_RECURRENT_ENABLED=0
TBANK_RECURRENT_BANK_APPROVED=0

# Enable partner project monitoring after updating TrioZ and assigning CONSULTANT.
PROJECT_MONITOR_ENABLED=0
