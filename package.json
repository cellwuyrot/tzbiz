{
  "name": "trioz-services-portal",
  "version": "1.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-sync.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node scripts/prisma-sync.mjs && prisma generate",
    "db:migrate": "node scripts/prisma-sync.mjs && prisma migrate dev",
    "db:deploy": "node scripts/prisma-sync.mjs && prisma migrate deploy",
    "db:seed": "node scripts/seed.mjs",
    "db:studio": "node scripts/prisma-sync.mjs && prisma studio",
    "predev": "node scripts/prisma-sync.mjs && prisma generate && prisma migrate deploy",
    "db:setup": "node scripts/prisma-sync.mjs && prisma generate && prisma migrate deploy && node scripts/seed.mjs",
    "jobs:run": "tsx scripts/jobs.ts",
    "test:integration": "vitest run tests/payment-flow.test.ts tests/tz-id-callback.test.ts",
    "launch:check": "tsx scripts/launch-check.ts",
    "test:invoices": "vitest run tests/invoices.test.ts tests/payment-flow.test.ts",
    "content:labels": "tsx scripts/rename-display-labels.ts",
    "test:admin": "vitest run tests/admin-all-routes.test.ts tests/api-auth.test.ts tests/session-status.test.ts tests/password-reset.test.ts",
    "test:catalog": "vitest run tests/catalog-privacy.test.ts tests/upload-access.test.ts tests/upload-removal.test.ts",
    "legal:templates": "tsx scripts/export-legal.ts",
    "account:link-tz": "tsx scripts/link-tz-account.ts",
    "payment:reconcile": "tsx scripts/reconcile-payment.ts",
    "images:check": "tsx scripts/image-check.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.2",
    "next": "^15.5.28",
    "nodemailer": "^10.2.1",
    "openid-client": "^6.8.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.30",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "postcss": "$postcss",
    "postcss-selector-parser": "^7.1.6",
    "source-map-js": "^1.2.2"
  }
}
