{
  "name": "trioz-services-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-sync.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node scripts/prisma-sync.mjs && prisma generate",
    "db:migrate": "node scripts/prisma-sync.mjs && prisma migrate dev",
    "db:deploy": "node scripts/prisma-sync.mjs && prisma migrate deploy",
    "db:seed": "node scripts/seed.mjs",
    "db:studio": "node scripts/prisma-sync.mjs && prisma studio",
    "predev": "node scripts/prisma-sync.mjs && prisma generate && prisma migrate deploy",
    "db:setup": "node scripts/prisma-sync.mjs && prisma generate && prisma migrate deploy && node scripts/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.2",
    "next": "^15.5.7",
    "nodemailer": "^6.9.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.7",
    "postcss": "^8.5.6",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
